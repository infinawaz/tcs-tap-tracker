{
  "name": "tcs-tap-tracker",
  "version": "1.0.0",
  "description": "TCS Tap Tracker – Mobile Attendance Application",
  "private": true,
  "scripts": {
    "sync":         "npx cap sync",
    "open:android": "npx cap open android",
    "build:apk":    "cd android && ./gradlew assembleDebug",
    "build:apk:win": "cd android && gradlew.bat assembleDebug",
    "serve":        "npx serve www -p 8080"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli":     "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "serve":              "^14.2.3"
  },
  "keywords": ["capacitor", "android", "attendance", "tcs"],
  "license": "UNLICENSED"
}
